generator client {
    provider     = "prisma-client-js"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

model UserRole {
    id          Int     @id @default(autoincrement())
    name        String  @unique @db.VarChar(255)
    description String?
    isActive    Boolean @default(true) @map("is_active")

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

    users User[]

    @@map("user_roles")
}

model User {
    id           Int    @id @default(autoincrement())
    name         String @db.VarChar(255)
    email        String @unique @db.VarChar(255)
    passwordHash String @map("password_hash") @db.VarChar(255)

    roleId   Int     @map("role_id")
    isActive Boolean @default(true) @map("is_active")

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

    role          UserRole       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
    activities    Activity[]
    refreshTokens RefreshToken[]

    @@map("users")
}

model Industry {
    id          Int     @id @default(autoincrement())
    name        String  @unique @db.VarChar(255)
    description String?
    isActive    Boolean @default(true) @map("is_active")

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

    clients Client[]

    @@map("industries")
}

model ClientType {
    id          Int     @id @default(autoincrement())
    name        String  @unique @db.VarChar(255)
    description String?
    isActive    Boolean @default(true) @map("is_active")

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

    clients Client[]

    @@map("client_types")
}

model ClientStatus {
    id          Int     @id @default(autoincrement())
    name        String  @unique @db.VarChar(255)
    description String?
    isActive    Boolean @default(true) @map("is_active")
    code        String

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

    clients Client[]

    @@map("client_statuses")
}

model Client {
    id      Int     @id @default(autoincrement())
    name    String  @db.VarChar(255)
    email   String  @unique @db.VarChar(255)
    phone   String  @db.VarChar(50)
    company String  @db.VarChar(255)
    avatar  String? @db.VarChar(500)

    clientTypeId   Int? @map("client_type_id")
    clientStatusId Int  @map("client_status_id")
    industryId     Int? @map("industry_id")

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

    clientType ClientType? @relation(fields: [clientTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    clientStatus ClientStatus @relation(fields: [clientStatusId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    industry Industry? @relation(fields: [industryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    @@map("clients")
}

model Activity {
    id         Int    @id @default(autoincrement())
    message    String
    entityId   Int    @map("entity_id")
    entityType String @map("entity_type")
    actorId    Int    @map("actor_id")

    oldValue Json? @map("old_value")
    newValue Json? @map("new_value")

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

    actor User @relation(fields: [actorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([entityId, entityType])
    @@index([actorId])
    @@map("activities")
}

enum ActivityEntityType {
    user
    client
}

model RefreshToken {
    id               Int    @id @default(autoincrement())
    refreshTokenHash String @map("refresh_token_hash")

    userId Int @map("user_id")

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
    expiresAt DateTime  @map("expires_at") @db.Timestamptz
    revokedAt DateTime? @map("revoked_at") @db.Timestamptz

    user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("refresh_tokens")
}
